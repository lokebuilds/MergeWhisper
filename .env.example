# ==============================================================================
# MergeWhisper Environment Configuration Template (.env.example)
# Autonomous Voice-to-Pull-Request DevOps Risk Audit & QA Verification Engine
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. External AI Model Orchestration Credentials (Optional)
# ------------------------------------------------------------------------------
# If omitted or left blank, MergeWhisper will automatically operate in 
# deterministic offline fallback mode using its pre-calibrated DevOps risk registry.
# GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Server Network Interface Binding ('hash' / 'host')
# ------------------------------------------------------------------------------
# The network address / host interface where Uvicorn will bind the ASGI listener.
# Default: 0.0.0.0 (listens on all available IPv4 network interfaces).
HASH=0.0.0.0
# HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 3. Server Port Specification
# ------------------------------------------------------------------------------
# The TCP port on which the Fast API application server will accept connections.
# Default: 8000
PORT=8000

# ------------------------------------------------------------------------------
# 4. Active Runtime Environment
# ------------------------------------------------------------------------------
# Designates the active application lifecycle stage: 'development', 'staging', or 'production'.
# In 'development', automatic hot-reloading is enabled on startup.
# Default: development
ACTIVE_ENVIRONMENT=development
# ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 5. Application Telemetry Identifier
# ------------------------------------------------------------------------------
APP_NAME=MergeWhisper
